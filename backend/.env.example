# Environment configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql://urbanpulse:urbanpulse_secret@localhost:5432/urbanpulse_db?schema=public

# Redis connection string for caching and BullMQ queues
REDIS_URL=redis://localhost:6379

# Cryptographic JWT secrets (Must be at least 32 characters long)
JWT_SECRET=development_jwt_secret_must_be_thirty_two_chars_long_minimum
JWT_REFRESH_SECRET=development_refresh_secret_thirty_two_chars_long_minimum

# ML Service endpoint
ML_SERVICE_URL=http://localhost:8000

# External API providers
OPENAQ_API_KEY=
GEMINI_API_KEY=

# CORS & Rate Limiting
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
